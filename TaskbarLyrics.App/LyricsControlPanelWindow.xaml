<Window x:Class="TaskbarLyrics.App.LyricsControlPanelWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="播放控制" Width="360" Height="124" WindowStyle="None" ResizeMode="NoResize"
 ShowInTaskbar="False" ShowActivated="False" AllowsTransparency="True" Background="Transparent" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PlaybackControlStyles.xaml"/></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
 <Grid x:Name="VisualRoot" Opacity="0">
  <Border x:Name="Surface" CornerRadius="12" Padding="12" Background="#01000000">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="8"/><RowDefinition Height="28"/></Grid.RowDefinitions>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border CornerRadius="6" Background="{DynamicResource PanelLine}">
      <Grid><TextBlock x:Name="CoverFallback" Text="♫" FontSize="25" Foreground="{DynamicResource PanelSubtle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <Border x:Name="CoverSurface" CornerRadius="6"><Border.Background><ImageBrush x:Name="CoverBrush" Stretch="UniformToFill"/></Border.Background></Border>
      </Grid>
     </Border>
     <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
      <TextBlock x:Name="TitleText" Text="暂无播放" FontSize="14" FontWeight="SemiBold" LineHeight="20" Foreground="{DynamicResource PanelForeground}" TextTrimming="CharacterEllipsis" Focusable="True" ToolTipService.InitialShowDelay="400"/>
      <TextBlock x:Name="ArtistText" Text="当前没有播放内容" Margin="0,2,0,0" FontSize="12" LineHeight="16" Foreground="{DynamicResource PanelSubtle}" TextTrimming="CharacterEllipsis" Focusable="True" ToolTipService.InitialShowDelay="400"/>
      <Grid x:Name="SourceRow" Margin="0,4,0,0" Visibility="Collapsed">
       <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border x:Name="SourceMark" Width="12" Height="12" VerticalAlignment="Center" CornerRadius="4">
        <Grid>
         <TextBlock x:Name="SourceFallback" Text="♫" Foreground="{DynamicResource PanelSubtle}" FontSize="10" LineHeight="12" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         <Image x:Name="SourceIcon" Width="12" Height="12" Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>
       </Border>
       <TextBlock x:Name="SourceText" Grid.Column="1" Margin="5,0,0,0" FontSize="11" LineHeight="14" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" Foreground="{DynamicResource PanelSubtle}" TextTrimming="CharacterEllipsis"/>
      </Grid>
     </StackPanel>
                <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                    <Button x:Name="PreviousButton" Style="{StaticResource MediaButton}" Click="OnPrevious" AutomationProperties.Name="上一首" IsEnabled="False">
                        <Viewbox Width="22" Height="22"><Canvas Width="24" Height="24">
                            <Path Data="M18.1 5.2c.8-.5 1.9.1 1.9 1.1v11.4c0 1-1.1 1.6-1.9 1.1l-8.5-5.7a1.3 1.3 0 0 1 0-2.2l8.5-5.7Z" Fill="{DynamicResource PanelForeground}"/>
                            <Path Data="M5 5.5v13" Stroke="{DynamicResource PanelForeground}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas></Viewbox>
                    </Button>
                    <Button x:Name="PlayButton" Tag="round" Style="{StaticResource MediaButton}" Width="36" Height="36" Margin="6,0" Background="{DynamicResource PanelButton}" Click="OnPlay" AutomationProperties.Name="播放" IsEnabled="False">
                        <Viewbox Width="22" Height="22"><Canvas Width="24" Height="24">
                            <Path x:Name="PlayGlyph" Data="M8 5.6c0-.95 1.05-1.5 1.83-.97l9 6.18c.82.56.82 1.82 0 2.38l-9 6.18C9.05 19.9 8 19.35 8 18.4V5.6Z" Fill="{DynamicResource PanelButtonText}"/>
                            <Path x:Name="PauseGlyph" Data="M8 5.5v13m8-13v13" Visibility="Collapsed" Stroke="{DynamicResource PanelButtonText}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas></Viewbox>
                    </Button>
                    <Button x:Name="NextButton" Style="{StaticResource MediaButton}" Click="OnNext" AutomationProperties.Name="下一首" IsEnabled="False">
                        <Viewbox Width="22" Height="22"><Canvas Width="24" Height="24">
                            <Path Data="M5.9 5.2C5.1 4.7 4 5.3 4 6.3v11.4c0 1 1.1 1.6 1.9 1.1l8.5-5.7a1.3 1.3 0 0 0 0-2.2L5.9 5.2Z" Fill="{DynamicResource PanelForeground}"/>
                            <Path Data="M19 5.5v13" Stroke="{DynamicResource PanelForeground}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas></Viewbox>
                    </Button>
                </StackPanel>

    </Grid>
    <Grid Grid.Row="2">
     <Grid.RowDefinitions><RowDefinition Height="14"/><RowDefinition Height="14"/></Grid.RowDefinitions>
     <Slider x:Name="SeekSlider" Height="14" Minimum="0" Maximum="1000" SmallChange="5" LargeChange="50" IsEnabled="False" AutomationProperties.Name="播放位置" PreviewKeyDown="OnSeekKeyDown" KeyUp="OnSeekKeyUp" ValueChanged="OnSeekValueChanged"/>
     <TextBlock x:Name="ElapsedText" Grid.Row="1" Text="0:00" FontSize="11" Foreground="{DynamicResource PanelSubtle}"/>
     <TextBlock x:Name="DurationText" Grid.Row="1" Text="0:00" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource PanelSubtle}"/>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</Window>
