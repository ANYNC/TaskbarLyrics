<Window x:Class="TaskbarLyrics.App.FloatingResizeGripWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:TaskbarLyrics.App"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{local:Translate Text='UI_ResizeFloatingWindow'}" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" AllowsTransparency="True" Background="Transparent"
        Width="24" Height="24" UseLayoutRounding="True" PreviewKeyDown="OnPreviewKeyDown">
    <Thumb x:Name="Grip" Cursor="SizeNESW" IsTabStop="False"
           AutomationProperties.Name="{local:Translate Text='UI_ResizeFloatingWindowHorizontallyForWidthVerticallyForScale'}"
           DragStarted="OnDragStarted" DragDelta="OnDragDelta" DragCompleted="OnDragCompleted">
        <Thumb.Template>
            <ControlTemplate TargetType="Thumb">
                <Grid Background="#01000000">
                    <Path x:Name="Triangle" Width="10" Height="10" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Margin="0,6,6,0" Data="M1.45,0 H6.5 A3.5,3.5 0 0 1 10,3.5 V8.55 A0.6,0.6 0 0 1 8.976,8.976 L1.024,1.024 A0.6,0.6 0 0 1 1.45,0 Z"
                          Fill="{DynamicResource GripForeground}" Opacity="0.3"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Triangle" Property="Opacity" Value="0.75"/></Trigger>
                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="Triangle" Property="Opacity" Value="1"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Thumb.Template>
    </Thumb>
</Window>
