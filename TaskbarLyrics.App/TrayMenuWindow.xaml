<Window x:Class="TaskbarLyrics.App.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:TaskbarLyrics.App"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Width="210"
        Height="339"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="TrayMenuBackgroundBrush" Color="#1E1E1E" />
        <SolidColorBrush x:Key="TrayMenuHoverBrush" Color="#303030" />
        <SolidColorBrush x:Key="TrayMenuPressedBrush" Color="#3A3A3A" />
        <SolidColorBrush x:Key="TrayMenuTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TrayMenuMutedTextBrush" Color="#B4B4B4" />
        <SolidColorBrush x:Key="TrayMenuSeparatorBrush" Color="#4A4A4A" />
        <SolidColorBrush x:Key="TrayModeTrackBrush" Color="#141414" />
        <SolidColorBrush x:Key="TrayModeSelectedBrush" Color="#424242" />
        <SolidColorBrush x:Key="TrayModeForegroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TrayModeSelectedForegroundBrush" Color="#FFFFFF" />

        <Style x:Key="TrayModeButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TrayModeForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment" CornerRadius="4" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TrayMenuHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TrayModeSelectedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TrayModeSelectedForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource TrayMenuMutedTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrayMenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Border x:Name="HoverOverlay"
                                        Background="{DynamicResource TrayMenuHoverBrush}"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                                <Border x:Name="PressedOverlay"
                                        Background="{DynamicResource TrayMenuPressedBrush}"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PressedOverlay" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Top">
                                <Setter TargetName="Chrome" Property="CornerRadius" Value="8,8,0,0" />
                                <Setter TargetName="HoverOverlay" Property="CornerRadius" Value="8,8,0,0" />
                                <Setter TargetName="PressedOverlay" Property="CornerRadius" Value="8,8,0,0" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Bottom">
                                <Setter TargetName="Chrome" Property="CornerRadius" Value="0,0,8,8" />
                                <Setter TargetName="HoverOverlay" Property="CornerRadius" Value="0,0,8,8" />
                                <Setter TargetName="PressedOverlay" Property="CornerRadius" Value="0,0,8,8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Border x:Name="MenuSurface"
                CornerRadius="8"
                Background="{DynamicResource TrayMenuBackgroundBrush}"
                ClipToBounds="True">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <Grid Height="48">
                        <Border Margin="8" Padding="2" CornerRadius="6" Background="{DynamicResource TrayModeTrackBrush}">
                            <Grid AutomationProperties.Name="{local:Translate Text='UI_DisplayMode_23'}">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <RadioButton x:Name="TaskbarModeButton" Content="{local:Translate Text='UI_TaskbarMode'}" GroupName="DisplayMode"
                                             Style="{StaticResource TrayModeButtonStyle}"
                                             AutomationProperties.Name="{local:Translate Text='UI_DisplayModeTaskbar'}"
                                             Click="DisplayModeButton_Click" Checked="DisplayModeButton_Checked" PreviewKeyDown="DisplayModeButton_KeyDown" />
                                <RadioButton x:Name="FloatingModeButton" Grid.Column="1" Content="{local:Translate Text='UI_FloatingMode'}" GroupName="DisplayMode"
                                             Style="{StaticResource TrayModeButtonStyle}"
                                             AutomationProperties.Name="{local:Translate Text='UI_DisplayModeFloating'}"
                                             Click="DisplayModeButton_Click" Checked="DisplayModeButton_Checked" PreviewKeyDown="DisplayModeButton_KeyDown" />
                            </Grid>
                        </Border>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource TrayMenuSeparatorBrush}" />
                </StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="3"
                            Style="{StaticResource TrayMenuButtonStyle}"
                            Click="ToggleLyricsButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{local:Translate Text='UI_ShowHideLyrics'}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TrayMenuTextBrush}"
                                       FontFamily="Microsoft YaHei UI"
                                       FontSize="12.5"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ToggleLyricsHotkeyText"
                                       Grid.Column="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TrayMenuMutedTextBrush}"
                                       FontFamily="Microsoft YaHei UI"
                                       FontSize="9.5" />
                        </Grid>
                    </Button>

                    <Button Grid.Row="4"
                            Style="{StaticResource TrayMenuButtonStyle}"
                            Click="ToggleTranslationButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{local:Translate Text='UI_ToggleTranslation'}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TrayMenuTextBrush}"
                                       FontFamily="Microsoft YaHei UI"
                                       FontSize="12.5"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ToggleTranslationHotkeyText"
                                       Grid.Column="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TrayMenuMutedTextBrush}"
                                       FontFamily="Microsoft YaHei UI"
                                       FontSize="9.5" />
                        </Grid>
                    </Button>

                    <Button Grid.Row="5"
                            Style="{StaticResource TrayMenuButtonStyle}"
                            Click="ToggleWordScanningButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{local:Translate Text='UI_ToggleWordHighlighting'}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TrayMenuTextBrush}"
                                       FontFamily="Microsoft YaHei UI"
                                       FontSize="12.5"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ToggleWordScanningHotkeyText"
                                       Grid.Column="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TrayMenuMutedTextBrush}"
                                       FontFamily="Microsoft YaHei UI"
                                       FontSize="9.5" />
                        </Grid>
                    </Button>

                    <Button x:Name="SpectrumMenuButton"
                            Grid.Row="6"
                            Style="{StaticResource TrayMenuButtonStyle}"
                            Click="SpectrumMenuButton_Click"
                            MouseEnter="SpectrumMenuButton_MouseEnter"
                            MouseLeave="SpectrumMenuButton_MouseLeave">
                        <Grid>
                            <TextBlock Text="{local:Translate Text='UI_ShowSpectrum'}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TrayMenuTextBrush}"
                                       FontFamily="Microsoft YaHei UI"
                                       FontSize="12.5" />
                            <TextBlock Text="›"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TrayMenuTextBrush}"
                                       FontFamily="Microsoft YaHei UI"
                                       FontSize="12.5" />
                        </Grid>
                    </Button>

                    <Border Grid.Row="2"
                            Height="1"
                            VerticalAlignment="Center"
                            Background="{DynamicResource TrayMenuSeparatorBrush}" />

                    <Button Grid.Row="0"
                            Style="{StaticResource TrayMenuButtonStyle}"
                            Click="SmtcMonitorButton_Click">
                        <TextBlock Text="{local:Translate Text='UI_SMTCMonitor'}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TrayMenuTextBrush}"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="12.5" />
                    </Button>

                    <Button Grid.Row="1"
                            Style="{StaticResource TrayMenuButtonStyle}"
                            Click="SpectrumTuningButton_Click">
                        <TextBlock Text="{local:Translate Text='UI_SpectrumTuning'}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TrayMenuTextBrush}"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="12.5" />
                    </Button>

                    <Button Grid.Row="7"
                            Style="{StaticResource TrayMenuButtonStyle}"
                            Click="TrackOffsetButton_Click">
                        <TextBlock Text="{local:Translate Text='UI_AdjustCurrentTrackOffset'}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TrayMenuTextBrush}"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="12.5" />
                    </Button>

                    <Button Grid.Row="8"
                            Style="{StaticResource TrayMenuButtonStyle}"
                            Click="SettingsButton_Click">
                        <TextBlock Text="{local:Translate Text='UI_Settings'}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TrayMenuTextBrush}"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="12.5" />
                    </Button>

                    <Border Grid.Row="9"
                            Height="1"
                            VerticalAlignment="Center"
                            Background="{DynamicResource TrayMenuSeparatorBrush}" />

                    <Button Grid.Row="10"
                            Style="{StaticResource TrayMenuButtonStyle}"
                            Tag="Bottom"
                            Click="ExitButton_Click">
                        <TextBlock Text="{local:Translate Text='UI_Exit'}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TrayMenuTextBrush}"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="12.5" />
                    </Button>
                </Grid>
            </DockPanel>
        </Border>

        <primitives:Popup x:Name="SpectrumModePopup"
                          PlacementTarget="{Binding ElementName=SpectrumMenuButton}"
                          Placement="Left"
                          HorizontalOffset="-1"
                          AllowsTransparency="True"
                          PopupAnimation="Fade"
                          StaysOpen="True">
            <Border Width="210"
                    CornerRadius="8"
                    Background="{DynamicResource TrayMenuBackgroundBrush}"
                    ClipToBounds="True"
                    MouseEnter="SpectrumModePopup_MouseEnter"
                    MouseLeave="SpectrumModePopup_MouseLeave">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
                            Tag="Disabled"
                            Style="{StaticResource TrayMenuButtonStyle}"
                            Click="SpectrumModeButton_Click">
                        <Grid>
                            <TextBlock Text="{local:Translate Text='UI_Close'}" VerticalAlignment="Center" Foreground="{DynamicResource TrayMenuTextBrush}" FontFamily="Microsoft YaHei UI" FontSize="12.5" />
                            <TextBlock x:Name="SpectrumDisabledCheck" Text="✓" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TrayMenuTextBrush}" FontFamily="Microsoft YaHei UI" FontSize="12.5" />
                        </Grid>
                    </Button>

                    <Button Grid.Row="1"
                            Tag="PureMusicOnly"
                            Style="{StaticResource TrayMenuButtonStyle}"
                            Click="SpectrumModeButton_Click">
                        <Grid>
                            <TextBlock Text="{local:Translate Text='UI_InstrumentalOnly'}" VerticalAlignment="Center" Foreground="{DynamicResource TrayMenuTextBrush}" FontFamily="Microsoft YaHei UI" FontSize="12.5" />
                            <TextBlock x:Name="SpectrumPureMusicCheck" Text="✓" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TrayMenuTextBrush}" FontFamily="Microsoft YaHei UI" FontSize="12.5" />
                        </Grid>
                    </Button>

                    <Button Grid.Row="2"
                            Tag="PureMusicOrNoLyrics"
                            Style="{StaticResource TrayMenuButtonStyle}"
                            Click="SpectrumModeButton_Click">
                        <Grid>
                            <TextBlock Text="{local:Translate Text='UI_InstrumentalOrNoLyrics'}" VerticalAlignment="Center" Foreground="{DynamicResource TrayMenuTextBrush}" FontFamily="Microsoft YaHei UI" FontSize="12.5" />
                            <TextBlock x:Name="SpectrumNoLyricsCheck" Text="✓" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TrayMenuTextBrush}" FontFamily="Microsoft YaHei UI" FontSize="12.5" />
                        </Grid>
                    </Button>

                    <Button Grid.Row="3"
                            Tag="Always"
                            Style="{StaticResource TrayMenuButtonStyle}"
                            Click="SpectrumModeButton_Click">
                        <Grid>
                            <TextBlock Text="{local:Translate Text='UI_Always'}" VerticalAlignment="Center" Foreground="{DynamicResource TrayMenuTextBrush}" FontFamily="Microsoft YaHei UI" FontSize="12.5" />
                            <TextBlock x:Name="SpectrumAlwaysCheck" Text="✓" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TrayMenuTextBrush}" FontFamily="Microsoft YaHei UI" FontSize="12.5" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>
        </primitives:Popup>
    </Grid>
</Window>
