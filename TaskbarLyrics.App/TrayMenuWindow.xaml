<Window x:Class="TaskbarLyrics.App.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Width="210"
        Height="290"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="TrayMenuBackgroundBrush" Color="#1E1E1E" />
        <SolidColorBrush x:Key="TrayMenuHoverBrush" Color="#303030" />
        <SolidColorBrush x:Key="TrayMenuPressedBrush" Color="#3A3A3A" />
        <SolidColorBrush x:Key="TrayMenuTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TrayMenuMutedTextBrush" Color="#B4B4B4" />
        <SolidColorBrush x:Key="TrayMenuSeparatorBrush" Color="#4A4A4A" />
        <SolidColorBrush x:Key="TrayMenuSwitchOnBrush" Color="#2F6FEB" />
        <SolidColorBrush x:Key="TrayMenuSwitchOnTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TrayMenuSwitchOffBrush" Color="#5A5A5A" />
        <SolidColorBrush x:Key="TrayMenuSwitchKnobBrush" Color="#FFFFFF" />

        <Style x:Key="TrayMenuSegmentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Segment"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10,0,0,10">
                            <Grid>
                                <Border x:Name="HoverOverlay"
                                        Background="{DynamicResource TrayMenuHoverBrush}"
                                        CornerRadius="10,0,0,10"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.5"
                                                         Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="Tag" Value="Right">
                                <Setter TargetName="Segment" Property="CornerRadius" Value="0,10,10,0" />
                                <Setter TargetName="HoverOverlay" Property="CornerRadius" Value="0,10,10,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrayMenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Border x:Name="HoverOverlay"
                                        Background="{DynamicResource TrayMenuHoverBrush}"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                                <Border x:Name="PressedOverlay"
                                        Background="{DynamicResource TrayMenuPressedBrush}"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PressedOverlay" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Top">
                                <Setter TargetName="Chrome" Property="CornerRadius" Value="8,8,0,0" />
                                <Setter TargetName="HoverOverlay" Property="CornerRadius" Value="8,8,0,0" />
                                <Setter TargetName="PressedOverlay" Property="CornerRadius" Value="8,8,0,0" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Bottom">
                                <Setter TargetName="Chrome" Property="CornerRadius" Value="0,0,8,8" />
                                <Setter TargetName="HoverOverlay" Property="CornerRadius" Value="0,0,8,8" />
                                <Setter TargetName="PressedOverlay" Property="CornerRadius" Value="0,0,8,8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="MenuSurface"
                CornerRadius="8"
                Background="{DynamicResource TrayMenuBackgroundBrush}"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition x:Name="FloatingInputModeRowDefinition" Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>

                <Button Grid.Row="3"
                        Style="{StaticResource TrayMenuButtonStyle}"
                        Click="ToggleLyricsButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="显示/隐藏歌词"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TrayMenuTextBrush}"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="12.5"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ToggleLyricsHotkeyText"
                                   Grid.Column="1"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TrayMenuMutedTextBrush}"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="9.5" />
                    </Grid>
                </Button>

                <Button Grid.Row="4"
                        Style="{StaticResource TrayMenuButtonStyle}"
                        Click="ToggleTranslationButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="开启/关闭翻译"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TrayMenuTextBrush}"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="12.5"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ToggleTranslationHotkeyText"
                                   Grid.Column="1"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TrayMenuMutedTextBrush}"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="9.5" />
                    </Grid>
                </Button>

                <Button Grid.Row="5"
                        Style="{StaticResource TrayMenuButtonStyle}"
                        Click="ToggleWordScanningButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="开启/关闭逐词扫描"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TrayMenuTextBrush}"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="12.5"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ToggleWordScanningHotkeyText"
                                   Grid.Column="1"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TrayMenuMutedTextBrush}"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="9.5" />
                    </Grid>
                </Button>

                <Button x:Name="SpectrumMenuButton"
                        Grid.Row="6"
                        Style="{StaticResource TrayMenuButtonStyle}"
                        Click="SpectrumMenuButton_Click"
                        MouseEnter="SpectrumMenuButton_MouseEnter"
                        MouseLeave="SpectrumMenuButton_MouseLeave">
                    <Grid>
                        <TextBlock Text="显示频谱"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TrayMenuTextBrush}"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="12.5" />
                        <TextBlock Text="›"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TrayMenuTextBrush}"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="12.5" />
                    </Grid>
                </Button>

                <Border Grid.Row="2"
                        Height="1"
                        VerticalAlignment="Center"
                        Background="{DynamicResource TrayMenuSeparatorBrush}" />

                <Button Grid.Row="0"
                        Style="{StaticResource TrayMenuButtonStyle}"
                        Tag="Top"
                        Click="SmtcMonitorButton_Click">
                    <TextBlock Text="SMTC 监视器"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TrayMenuTextBrush}"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="12.5" />
                </Button>

                <Button Grid.Row="1"
                        Style="{StaticResource TrayMenuButtonStyle}"
                        Click="SpectrumTuningButton_Click">
                    <TextBlock Text="频谱调试"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TrayMenuTextBrush}"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="12.5" />
                </Button>

                <Border x:Name="FloatingInputModeSwitch"
                        Grid.Row="7"
                        Height="24"
                        Margin="16,0"
                        Padding="2"
                        VerticalAlignment="Center"
                        CornerRadius="12"
                        Background="{DynamicResource TrayMenuSwitchOffBrush}"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="FloatingClickThroughSegment"
                                Grid.Column="0"
                                Style="{StaticResource TrayMenuSegmentButtonStyle}"
                                ToolTip="开启后悬浮窗不响应鼠标操作，直接穿透到下层窗口"
                                Click="FloatingClickThroughButton_Click">
                            <TextBlock x:Name="FloatingClickThroughLabel"
                                       Text="鼠标穿透"
                                       Foreground="{DynamicResource TrayMenuMutedTextBrush}"
                                       FontFamily="Microsoft YaHei UI"
                                       FontSize="11.5" />
                        </Button>
                        <Button x:Name="FloatingFreeDragSegment"
                                Grid.Column="1"
                                Tag="Right"
                                Style="{StaticResource TrayMenuSegmentButtonStyle}"
                                ToolTip="开启后可直接拖动悬浮窗调整位置"
                                Click="FloatingFreeDragButton_Click">
                            <TextBlock x:Name="FloatingFreeDragLabel"
                                       Text="调整位置"
                                       Foreground="{DynamicResource TrayMenuMutedTextBrush}"
                                       FontFamily="Microsoft YaHei UI"
                                       FontSize="11.5" />
                        </Button>
                    </Grid>
                </Border>

                <Button Grid.Row="8"
                        Style="{StaticResource TrayMenuButtonStyle}"
                        Click="TrackOffsetButton_Click">
                    <TextBlock Text="调整当前歌曲偏移"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TrayMenuTextBrush}"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="12.5" />
                </Button>

                <Button Grid.Row="9"
                        Style="{StaticResource TrayMenuButtonStyle}"
                        Click="SettingsButton_Click">
                    <TextBlock Text="设置"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TrayMenuTextBrush}"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="12.5" />
                </Button>

                <Border Grid.Row="10"
                        Height="1"
                        VerticalAlignment="Center"
                        Background="{DynamicResource TrayMenuSeparatorBrush}" />

                <Button Grid.Row="11"
                        Style="{StaticResource TrayMenuButtonStyle}"
                        Tag="Bottom"
                        Click="ExitButton_Click">
                    <TextBlock Text="退出"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TrayMenuTextBrush}"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="12.5" />
                </Button>
            </Grid>
        </Border>

        <primitives:Popup x:Name="SpectrumModePopup"
                          PlacementTarget="{Binding ElementName=SpectrumMenuButton}"
                          Placement="Left"
                          HorizontalOffset="-1"
                          AllowsTransparency="True"
                          PopupAnimation="Fade"
                          StaysOpen="True">
            <Border Width="210"
                    CornerRadius="8"
                    Background="{DynamicResource TrayMenuBackgroundBrush}"
                    ClipToBounds="True"
                    MouseEnter="SpectrumModePopup_MouseEnter"
                    MouseLeave="SpectrumModePopup_MouseLeave">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
                            Tag="Disabled"
                            Style="{StaticResource TrayMenuButtonStyle}"
                            Click="SpectrumModeButton_Click">
                        <Grid>
                            <TextBlock Text="关闭" VerticalAlignment="Center" Foreground="{DynamicResource TrayMenuTextBrush}" FontFamily="Microsoft YaHei UI" FontSize="12.5" />
                            <TextBlock x:Name="SpectrumDisabledCheck" Text="✓" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TrayMenuTextBrush}" FontFamily="Microsoft YaHei UI" FontSize="12.5" />
                        </Grid>
                    </Button>

                    <Button Grid.Row="1"
                            Tag="PureMusicOnly"
                            Style="{StaticResource TrayMenuButtonStyle}"
                            Click="SpectrumModeButton_Click">
                        <Grid>
                            <TextBlock Text="仅纯音乐时" VerticalAlignment="Center" Foreground="{DynamicResource TrayMenuTextBrush}" FontFamily="Microsoft YaHei UI" FontSize="12.5" />
                            <TextBlock x:Name="SpectrumPureMusicCheck" Text="✓" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TrayMenuTextBrush}" FontFamily="Microsoft YaHei UI" FontSize="12.5" />
                        </Grid>
                    </Button>

                    <Button Grid.Row="2"
                            Tag="PureMusicOrNoLyrics"
                            Style="{StaticResource TrayMenuButtonStyle}"
                            Click="SpectrumModeButton_Click">
                        <Grid>
                            <TextBlock Text="纯音乐或无歌词时" VerticalAlignment="Center" Foreground="{DynamicResource TrayMenuTextBrush}" FontFamily="Microsoft YaHei UI" FontSize="12.5" />
                            <TextBlock x:Name="SpectrumNoLyricsCheck" Text="✓" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TrayMenuTextBrush}" FontFamily="Microsoft YaHei UI" FontSize="12.5" />
                        </Grid>
                    </Button>

                    <Button Grid.Row="3"
                            Tag="Always"
                            Style="{StaticResource TrayMenuButtonStyle}"
                            Click="SpectrumModeButton_Click">
                        <Grid>
                            <TextBlock Text="始终显示" VerticalAlignment="Center" Foreground="{DynamicResource TrayMenuTextBrush}" FontFamily="Microsoft YaHei UI" FontSize="12.5" />
                            <TextBlock x:Name="SpectrumAlwaysCheck" Text="✓" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TrayMenuTextBrush}" FontFamily="Microsoft YaHei UI" FontSize="12.5" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>
        </primitives:Popup>
    </Grid>
</Window>
